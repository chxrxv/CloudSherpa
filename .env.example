# CloudSherpa configuration. Copy to `.env` and fill in. Every variable is optional except
# for LLM credentials (one of the two options below), and only needed for generation.
# Retrieval (ingest, index, `scripts/ask.py --retrieve-only`) runs with no credentials.

# ---------------------------------------------------------------------------------------
# LLM credentials — choose ONE
# ---------------------------------------------------------------------------------------
# Option A: Gemini Developer API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Option B: Vertex AI with Application Default Credentials
#   gcloud auth application-default login
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=us-central1

# ---------------------------------------------------------------------------------------
# Model routing (Flash for simple steps, Pro for the architect step)
# ---------------------------------------------------------------------------------------
# FLASH_MODEL=gemini-3.8-flash
# PRO_MODEL=gemini-3.1-pro-preview
# LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------------------
# EMBEDDING_PROVIDER=local          # local (fastembed, no key) | gemini
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# VECTOR_STORE=faiss                # faiss (local) | vertex (Vertex AI Vector Search)
# CHUNKING_STRATEGY=fixed           # fixed | markdown
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200
# CONTEXTUAL_HEADERS=false          # prepend "Title — Section" before embedding
# RETRIEVAL_MODE=hybrid             # dense | bm25 | hybrid
# RERANKER=cross-encoder            # cross-encoder | none
# TOP_K=5
# MIN_CONFIDENCE=0.10               # refuse below this reranker relevance probability

# ---------------------------------------------------------------------------------------
# Vertex AI Vector Search (only when VECTOR_STORE=vertex; needs `pip install -e .[gcp]`)
# ---------------------------------------------------------------------------------------
# VERTEX_INDEX_ID=
# VERTEX_INDEX_ENDPOINT_ID=
# VERTEX_DEPLOYED_INDEX_ID=
