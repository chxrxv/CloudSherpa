# CloudSherpa configuration. Copy to `.env` and fill in.
# Retrieval, the deterministic eval baseline (--no-llm) and the mocked smoke eval need NO key.

# ---------------------------------------------------------------------------------------
# LLM credentials: FREE TIER ONLY
# ---------------------------------------------------------------------------------------
# Create a key in Google AI Studio (https://aistudio.google.com/apikey) on a Google Cloud
# project with billing NOT enabled. Free-tier rate limits apply per project, not per key.
GEMINI_API_KEY=

# FREE_TIER_ONLY=true refuses Vertex AI, Vertex Vector Search and any model outside
# FREE_TIER_MODELS. Leave it on.
# FREE_TIER_ONLY=true
# FREE_TIER_MODELS=["gemini-3.8-flash","gemini-3.6-flash","gemini-3.5-flash-lite","gemini-3.1-flash-lite","gemini-embedding-2"]

# ---------------------------------------------------------------------------------------
# Models (free-tier Flash class; Pro has no free tier)
# ---------------------------------------------------------------------------------------
# FLASH_MODEL=gemini-3.8-flash      # answerer (model under test)
# STRONG_MODEL=gemini-3.8-flash     # architect step (phase 3)
# LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------------------------
# Free-tier rate limiting (per model). Google does not publish free-tier numbers; copy
# your project's limits from AI Studio. The defaults below are conservative placeholders.
# ---------------------------------------------------------------------------------------
# LLM_RPM=5                         # requests/minute throttle
# LLM_DAILY_REQUEST_BUDGET=100      # per model per Pacific-time day; the run stops cleanly
# LLM_MAX_RETRIES=6                 # attempts on 429/5xx (daily-quota 429s are not retried)
# LLM_BACKOFF_BASE_S=4              # exponential backoff base; server retry hints win
# LLM_BACKOFF_MAX_S=120

# ---------------------------------------------------------------------------------------
# LLM-as-judge
# ---------------------------------------------------------------------------------------
# JUDGE_BACKEND=gemini              # gemini | openai_compat (local fallback, e.g. Ollama)
# JUDGE_MODEL=gemini-3.6-flash      # must differ from FLASH_MODEL. For Ollama, the local
#                                   # model name, e.g. qwen2.5:7b-instruct
# JUDGE_BASE_URL=http://localhost:11434/v1
# JUDGE_API_KEY=

# ---------------------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------------------
# EMBEDDING_PROVIDER=local          # local (fastembed, no key) | gemini (free tier) | hash (CI)
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# VECTOR_STORE=faiss                # faiss | vertex (billed; blocked by FREE_TIER_ONLY)
# CHUNKING_STRATEGY=fixed           # fixed | markdown
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200
# CONTEXTUAL_HEADERS=false
# RETRIEVAL_MODE=hybrid             # dense | bm25 | hybrid
# RERANKER=cross-encoder            # cross-encoder | none
# TOP_K=5
# MIN_CONFIDENCE=0.10

# ---------------------------------------------------------------------------------------
# Billed options, kept in code but blocked while FREE_TIER_ONLY=true
# ---------------------------------------------------------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_CLOUD_PROJECT=
# VERTEX_INDEX_ID=
# VERTEX_INDEX_ENDPOINT_ID=
# VERTEX_DEPLOYED_INDEX_ID=
